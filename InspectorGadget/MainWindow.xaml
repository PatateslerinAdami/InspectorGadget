<Window x:Class="InspectorGadget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inspector Gadget" Height="700" Width="900" Background="#1E1E1E">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Replays Folder:" Foreground="White" VerticalAlignment="Center" Width="100"/>
            <TextBox x:Name="FolderPathTextBox" Width="400" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
            <Button Content="Browse..." Width="80" Click="BrowseButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="CSV Folder:" Foreground="White" VerticalAlignment="Center" Width="100"/>
            <TextBox x:Name="CsvPathTextBox" Width="400" Margin="0,0,10,0" VerticalContentAlignment="Center" ToolTip="Folder containing inibin_hashes.csv, luaobj_hashes.csv, troybin_hashes.csv"/>
            <Button Content="Browse..." Width="80" Click="BrowseCsvButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Champion:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="ChampionTextBox" Width="100" Margin="0,0,15,0" VerticalContentAlignment="Center" ToolTip="Leave blank to search all replays"/>

            <TextBlock Text="Spell Name:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="SpellNameTextBox" Width="150" Margin="0,0,15,0" VerticalContentAlignment="Center"/>

            <TextBlock Text="Track For (Sec):" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="TrackTimeTextBox" Width="40" Text="2.0" Margin="0,0,15,0" VerticalContentAlignment="Center"/>

            <TextBlock Text="Max Occurrences:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="MaxOccurrencesTextBox" Width="40" Text="5" Margin="0,0,15,0" VerticalContentAlignment="Center"/>

            <Button x:Name="ScanButton" Content="Start Scan" Width="100" Click="ScanButton_Click" FontWeight="Bold"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" Background="#2D2D30" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="OutputStack" Margin="5"/>
        </ScrollViewer>
    </Grid>
</Window>