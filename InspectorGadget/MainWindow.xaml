<Window x:Class="InspectorGadget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inspector Gadget" Height="700" Width="900" Background="#1E1E1E">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Replays Folder:" Foreground="White" VerticalAlignment="Center" Width="100"/>
            <TextBox x:Name="FolderPathTextBox" Width="400" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
            <Button Content="Browse..." Width="80" Click="BrowseButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="CSV Folder:" Foreground="White" VerticalAlignment="Center" Width="100"/>
            <TextBox x:Name="CsvPathTextBox" Width="400" Margin="0,0,10,0" VerticalContentAlignment="Center" ToolTip="Folder containing inibin_hashes.csv, luaobj_hashes.csv, troybin_hashes.csv"/>
            <Button Content="Browse..." Width="80" Click="BrowseCsvButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Champion:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="ChampionTextBox" Width="70" Margin="0,0,10,0" VerticalContentAlignment="Center" ToolTip="Leave blank to search all replays"/>

            <TextBlock Text="Entity:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="EntityTextBox" Width="80" Margin="0,0,10,0" VerticalContentAlignment="Center" ToolTip="e.g. SRU_ChaosMinionMelee"/>

            <TextBlock Text="Spell Name:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="SpellNameTextBox" Width="100" Margin="0,0,10,0" VerticalContentAlignment="Center"/>

            <TextBlock Text="Track For (Sec):" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="TrackTimeTextBox" Width="25" Text="2.0" Margin="0,0,10,0" VerticalContentAlignment="Center"/>

            <TextBlock Text="Max Occurrences:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="MaxOccurrencesTextBox" Width="25" Text="5" Margin="0,0,10,0" VerticalContentAlignment="Center"/>

            <TextBlock Text="Max Entities:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="MaxDumpTextBox" Width="25" Text="6" Margin="0,0,10,0" VerticalContentAlignment="Center" ToolTip="Max unique entities in Perspective dropdown"/>

            <Button x:Name="ScanButton" Content="Start Scan" Width="85" Click="ScanButton_Click" FontWeight="Bold" Margin="0,0,10,0"/>

            <ToggleButton x:Name="FiltersButton" Content="Filters ▼" Width="70"/>
            <Popup IsOpen="{Binding IsChecked, ElementName=FiltersButton}" StaysOpen="False" PlacementTarget="{Binding ElementName=FiltersButton}" AllowsTransparency="True" Margin="0,2,0,0">
                <Border Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Dynamic UI Filters" Foreground="#FFD700" FontWeight="Bold" Margin="0,0,0,5"/>
                        <CheckBox x:Name="ChkSpells" Content="Spells" IsChecked="True" Foreground="White" Margin="0,2"/>
                        <CheckBox x:Name="ChkMissiles" Content="Missiles" IsChecked="True" Foreground="White" Margin="0,2"/>
                        <CheckBox x:Name="ChkBuffs" Content="Buffs" IsChecked="True" Foreground="White" Margin="0,2"/>
                        <CheckBox x:Name="ChkVFX" Content="VFX" IsChecked="True" Foreground="White" Margin="0,2"/>
                        <CheckBox x:Name="ChkAnimations" Content="Animations" IsChecked="True" Foreground="White" Margin="0,2"/>
                        <CheckBox x:Name="ChkLookAt" Content="LookAt" IsChecked="True" Foreground="White" Margin="0,2"/>
                        <Separator Margin="0,5" Background="#3E3E42"/>
                        <CheckBox x:Name="ChkIncludeTargeted" Content="Include Targeted (Enemy hitting us)" IsChecked="True" Foreground="#FF6347" FontWeight="Bold" Margin="0,2" ToolTip="Requires Rescan to apply"/>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <ScrollViewer Grid.Row="3" Background="#2D2D30" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="OutputStack" Margin="5"/>
        </ScrollViewer>
    </Grid>
</Window>